# Installed by the k3s helm-controller once Cilium provides pod networking.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    # No SSO yet: log in as admin (argocd/argocd-initial-admin-secret).
    dex:
      enabled: false
    configs:
      params:
        # Plain HTTP inside the cluster; Teleport terminates TLS
        server.insecure: true
      cm:
        url: https://argocd.teleport.aws.trentonvanderwert.com
    # Teleport app "argocd"
    server:
      service:
        labels:
          teleport.dev/app: "true"
        annotations:
          teleport.dev/name: argocd
          teleport.dev/port: http
