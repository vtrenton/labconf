# BIND (authoritative only, 127.0.0.1:5300) for Unbound. --restart=always:
# podman-restart.service starts it at boot. Host network: it
# listens on localhost only (named.conf), and Unbound reaches it there.
podman run -d --name bind9 --restart=always --network host -e TZ=CST -v /bind/config/named.conf:/etc/bind/named.conf -v /bind/cache/:/var/cache/bind -v /bind/zones/:/etc/bind/zones docker.io/ubuntu/bind9:latest
