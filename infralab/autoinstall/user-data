#cloud-config
# Ubuntu Server 26.04 autoinstall for every infralab node. Identical on all
# nodes: the network supplies what differs (IP from the DHCP reservation,
# hostname from the PTR record for that IP). See README.md.
#
# ERASES THE LARGEST DISK.
autoinstall:
  version: 1
  source:
    id: ubuntu-server-minimal
  kernel:
    package: linux-generic
  locale: en_US.UTF-8
  keyboard:
    layout: us
  updates: all

  network:
    version: 2
    ethernets:
      lan:
        match:
          name: "en*"
        dhcp4: true

  # EFI + /boot + LUKS2 -> LVM -> / (100G root LV, rest of the VG free).
  # This passphrase only exists until late-commands wipe it, so it is not a
  # secret.
  storage:
    layout:
      name: lvm
      sizing-policy: scaled
      password: install-only-wiped-before-first-boot

  ssh:
    install-server: true
    allow-pw: false

  packages:
    - tpm2-tools   # dracut's tpm2-tss module requires the tpm2 binary
    - curl         # install-teleport

  # Root volume unlock: TPM2 bound to PCR 7 (Secure Boot state/keys) plus a
  # recovery key in /root/luks-recovery-key; the install passphrase is wiped.
  # Any failure aborts the install.
  late-commands:
    - curtin in-target -- sh -c 'echo "add_dracutmodules+=\" tpm2-tss \"" > /etc/dracut.conf.d/90-tpm2.conf'
    - curtin in-target -- sed -i -E '/^#/! s/^(\S+\s+\S+\s+\S+\s+\S*luks\S*)$/\1,tpm2-device=auto/' /etc/crypttab
    - >-
      curtin in-target -- sh -euc '
      dev=$(blkid -t TYPE=crypto_LUKS -o device | head -n1);
      export PASSWORD=install-only-wiped-before-first-boot;
      systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$dev";
      umask 077; systemd-cryptenroll --recovery-key "$dev" > /root/luks-recovery-key;
      test -s /root/luks-recovery-key;
      systemd-cryptenroll --wipe-slot=password "$dev";
      systemd-cryptenroll "$dev"'
    - curtin in-target -- update-initramfs -u -k all

  # cloud-init config for the installed system's first boot.
  user-data:
    preserve_hostname: true   # hostname comes from DNS, not cloud-init
    users:
      - name: sysadmin
        gecos: admin
        groups: [adm, sudo]
        shell: /bin/bash
        lock_passwd: true
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - ssh-rsa 
    write_files:
      - path: /usr/local/sbin/hostname-from-dns
        permissions: "0755"
        content: |
          #!/bin/sh
          # Set the hostname from the PTR record of the default-route address.
          set -eu
          ip=$(ip -4 route get 1.1.1.1 | sed -n 's/.* src \([0-9.]*\).*/\1/p')
          name=
          for _ in $(seq 30); do
            name=$(getent hosts "$ip" | awk '{print $2}')
            [ -n "$name" ] && break
            sleep 2
          done
          [ -n "$name" ] || { echo "no PTR record for $ip" >&2; exit 1; }
          short=${name%%.*}
          [ "$(hostname)" = "$short" ] || hostnamectl set-hostname "$short"
          if [ "$name" != "$short" ]; then entry="$name $short"; else entry=$short; fi
          sed -i "s/^127\.0\.1\.1\s.*/127.0.1.1 $entry/" /etc/hosts
          echo "hostname: $short ($ip)"
      - path: /etc/systemd/system/hostname-from-dns.service
        content: |
          [Unit]
          Description=Set hostname from reverse DNS
          Wants=network-online.target
          After=network-online.target
          Before=k3s.service

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/usr/local/sbin/hostname-from-dns

          [Install]
          WantedBy=multi-user.target
      # Teleport agent (SSH). Joins with the TPM: the node's EK hash is
      # allowed by the infralab-nodes token, managed by the Teleport operator
      # (infralab/argo-apps/teleport). Until that token exists the agent just
      # retries. No secret on the node.
      - path: /etc/teleport.yaml
        content: |
          version: v3
          teleport:
            # nodename: the hostname, set from DNS before teleport starts
            proxy_server: teleport.aws.trentonvanderwert.com:443
            join_params:
              method: tpm
              token_name: infralab-nodes
            log:
              output: stderr
              severity: INFO
          auth_service:
            enabled: false
          proxy_service:
            enabled: false
          ssh_service:
            enabled: true
            labels:
              lab: infralab
      - path: /etc/systemd/system/teleport.service.d/10-hostname.conf
        content: |
          # The node registers under its hostname, which comes from DNS.
          [Unit]
          Requires=hostname-from-dns.service
          After=hostname-from-dns.service
      - path: /usr/local/sbin/install-teleport
        permissions: "0755"
        content: |
          #!/bin/sh
          # Installs the Teleport agent under Managed Updates. This version only
          # bootstraps the updater; from then on teleport-update follows the
          # version the cluster advertises (autoupdate_version).
          set -eu
          v=18.11.3
          sha=d748d7aa6998ed59ff86b71bf78f438205327553badd221ea87288cbc91c2231
          f=teleport-update-v$v-linux-amd64-bin.tar.gz
          tmp=$(mktemp -d)
          trap 'rm -rf "$tmp"' EXIT
          cd "$tmp"
          curl -fsSLO "https://cdn.teleport.dev/$f"
          echo "$sha  $f" | sha256sum -c -
          tar -xzf "$f"
          ./teleport/teleport-update enable --proxy teleport.aws.trentonvanderwert.com:443 --group infralab
          systemctl enable --now teleport
    runcmd:
      - [systemctl, enable, --now, hostname-from-dns.service]
      - [/usr/local/sbin/install-teleport]
