# Root of the app-of-apps. k3s retries this until the Argo CD CRDs exist.
#
# The default AppProject is normally created by the application controller at
# startup, which can land after the root app: the app then sits at Unknown
# ("referencing project default which does not exist") until the next
# reconcile. Shipping it in the same file removes the race. Same spec as the
# one Argo CD creates.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: default
  namespace: argocd
spec:
  sourceRepos:
    - '*'
  destinations:
    - namespace: '*'
      server: '*'
  clusterResourceWhitelist:
    - group: '*'
      kind: '*'
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ argocd_repo_url }}
    targetRevision: {{ argocd_repo_revision }}
    path: {{ argocd_apps_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
