# Installed by the k3s helm-controller once Cilium provides pod networking.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    # SSO: "Log in via Teleport" -> Dex -> Teleport SAML IdP (service provider
    # "argocd", infralab/argo-apps/teleport-resources/argocd-sso.yaml).
    # Teleport roles arrive as groups; lab-admin = role:admin, anyone else gets
    # nothing. The local admin (argocd/argocd-initial-admin-secret) stays as
    # break-glass.
    dex:
      enabled: true
    configs:
      params:
        # Plain HTTP inside the cluster; Teleport terminates TLS
        server.insecure: true
      cm:
        url: https://argocd.teleport.aws.trentonvanderwert.com
        dex.config: |
          connectors:
            - type: saml
              id: teleport
              name: Teleport
              config:
                ssoURL: https://teleport.aws.trentonvanderwert.com/enterprise/saml-idp/sso
                ssoIssuer: https://teleport.aws.trentonvanderwert.com/enterprise/saml-idp/metadata
                entityIssuer: https://argocd.teleport.aws.trentonvanderwert.com/api/dex/callback
                redirectURI: https://argocd.teleport.aws.trentonvanderwert.com/api/dex/callback
                # Teleport SAML IdP signing cert (public; from
                # /enterprise/saml-idp/metadata, valid to 2036). Update on a
                # SAML IdP CA rotation.
                caData: 
                nameIDPolicyFormat: transient
                usernameAttr: username
                emailAttr: email
                groupsAttr: groups
      rbac:
        policy.default: ""
        policy.csv: |
          g, lab-admin, role:admin
        scopes: "[groups]"
    # Teleport app "argocd"
    server:
      service:
        labels:
          teleport.dev/app: "true"
        annotations:
          teleport.dev/name: argocd
          teleport.dev/port: http
