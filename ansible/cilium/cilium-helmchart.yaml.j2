# Installed by the k3s helm-controller. bootstrap: true lets the install job
# run on the host network before any CNI exists.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io
  chart: cilium
  version: "{{ cilium_version }}"
  targetNamespace: kube-system
  bootstrap: true
  valuesContent: |-
    # k3s serves the apiserver on 127.0.0.1:6444 on every node (the apiserver
    # itself on servers, the client load balancer on agents), so Cilium does
    # not depend on the VIP it announces.
    k8sServiceHost: 127.0.0.1
    k8sServicePort: 6444

    kubeProxyReplacement: true
    devices: {{ cilium_interface }}
    rollOutCiliumPods: true

    ipam:
      mode: cluster-pool
      operator:
        clusterPoolIPv4PodCIDRList:
          - 10.42.0.0/16
        clusterPoolIPv4MaskSize: 24

    # L2 announcements use leases, which adds API traffic
    l2announcements:
      enabled: true
    k8sClientRateLimit:
      qps: 20
      burst: 40

    gatewayAPI:
      enabled: true

    ingressController:
      enabled: true
      default: true
      loadbalancerMode: shared
      service:
        loadBalancerIP: {{ cilium_ingress_ip }}

    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
