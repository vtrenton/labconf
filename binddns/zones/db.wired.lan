$TTL 86400      ; Default TTL
; Wired LAN (home, 192.168.0.0/24). Machines that need a name get an A
; record here (and a DHCP reservation in udm-pro-config).
@       IN      SOA     labns.labnet.lan. admin.labnet.lan. (
                        2026110901  ; Serial
                        3600        ; Refresh
                        1800        ; Retry
                        604800      ; Expire
                        86400 )     ; Minimum TTL

@       IN      NS      labns.labnet.lan.

gateway         IN      A       192.168.0.1

; end of zone file
